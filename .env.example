# ── Core ─────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# ── MySQL ────────────────────────────────────────────
DB_NAME=ryuclass_db
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Celery / Redis ───────────────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# local.py runs tasks inline (EAGER) so you don't need Redis while developing

# ── Video decryption (legacy PHP AES-256-CBC) ────────
AES_KEY=
AES_IV=

# ── AI providers ─────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Payments / notifications ─────────────────────────
EASYSLIP_API_KEY=
MERCHANT_ACCOUNT_NUMBER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
RENEWAL_BONUS_DAYS=3

# ── Email (SMTP) ─────────────────────────────────────
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="RyuClass <support@chatbotth.me>"
